# Copy to .env. Values are server-only Nuxt runtime configuration.
# Supabase Cloud: Project Settings / API (or project Connect dialog).
# Example URL: https://your-project.supabase.co
NUXT_SUPABASE_URL=
NUXT_SUPABASE_PUBLISHABLE_KEY=

# Self-hosted: replace the URL with your Supabase API gateway URL and use
# its publishable/anon key. Never put a secret/service_role key here.
# Development without these values shows a setup notice; login stays disabled.
